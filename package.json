{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && tsx scripts/generateSitemap.ts && tsx scripts/prerender.ts && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --loader:.jpg=dataurl --loader:.png=dataurl --loader:.svg=dataurl --loader:.webp=dataurl --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.cjs",
    "test:authorization": "KURLA_STORE_MODE=memory KURLA_TEST_NO_SERVER=true tsx tests/authorization.test.ts",
    "test:hardening": "KURLA_STORE_MODE=memory KURLA_TEST_NO_SERVER=true tsx tests/production_hardening.test.ts",
    "test:integration": "KURLA_TEST_NO_SERVER=true tsx tests/supabase_integration.test.ts",
    "test:beauty-profile": "KURLA_STORE_MODE=memory KURLA_TEST_NO_SERVER=true tsx tests/beauty_profile.test.ts",
    "test:ai-product": "KURLA_STORE_MODE=memory KURLA_TEST_NO_SERVER=true tsx tests/ai_assistant_product.test.ts",
    "test:marketplace": "KURLA_STORE_MODE=memory KURLA_TEST_NO_SERVER=true tsx tests/marketplace_trust.test.ts",
    "test:adaptive-routines": "KURLA_STORE_MODE=memory KURLA_TEST_NO_SERVER=true tsx tests/adaptive_routines.test.ts",
    "test": "export KURLA_STORE_MODE=memory && npm run test:store-binding && npm run test:authorization && npm run test:hardening && npm run test:marketplace && npm run test:catalog && npm run test:admin-dashboard && npm run test:educational-content && npm run test:family-space && npm run test:adaptive-routines && npm run test:beauty-profile && npm run test:ai-product && npm run test:atomic-stock && npm run test:kurla-intelligence && npm run test:recommendation-engine && npm run test:chantier-a && npm run test:chantier-b && npm run test:chantier-7 && npm run test:chantier-7-seo && npm run test:chantier-7-prerender && npm run test:chantier-7-i18n && tsx tests/supabase.test.ts && tsx tests/phase5_operations.test.ts && tsc --noEmit",
    "lint": "tsc --noEmit",
    "test:catalog": "KURLA_STORE_MODE=memory KURLA_TEST_NO_SERVER=true tsx tests/catalog_management.test.ts",
    "test:admin-dashboard": "KURLA_STORE_MODE=memory KURLA_TEST_NO_SERVER=true tsx tests/admin_dashboard.test.ts",
    "test:educational-content": "KURLA_STORE_MODE=memory KURLA_TEST_NO_SERVER=true tsx tests/educational_content.test.ts",
    "test:family-space": "KURLA_STORE_MODE=memory KURLA_TEST_NO_SERVER=true tsx tests/family_space.test.ts",
    "test:atomic-stock": "KURLA_STORE_MODE=memory KURLA_TEST_NO_SERVER=true tsx tests/phase7_atomic_stock.test.ts",
    "test:atomic-stock-integration": "tsx tests/phase7_atomic_stock.integration.test.ts",
    "test:kurla-intelligence": "KURLA_STORE_MODE=memory KURLA_TEST_NO_SERVER=true tsx tests/kurla_intelligence.test.ts",
    "test:recommendation-engine": "KURLA_STORE_MODE=memory KURLA_TEST_NO_SERVER=true tsx tests/recommendation_engine.test.ts",
    "test:chantier-a": "KURLA_STORE_MODE=memory KURLA_TEST_NO_SERVER=true tsx tests/chantier_a_wiring.test.ts",
    "test:chantier-b": "KURLA_STORE_MODE=memory tsx tests/chantier_b_professional.test.ts",
    "test:store-binding": "tsx tests/store_binding.test.ts",
    "test:realdb-preflight": "KURLA_STORE_MODE=server tsx tests/real_database_preflight.test.ts",
    "test:realdb": "npm run test:realdb-preflight && npm run test:integration && npm run test:atomic-stock-integration && npm run test:schema-contract && npm run test:chantier-b:realdb && npm run test:chantier-7-ingredients",
    "test:chantier-b:realdb": "KURLA_STORE_MODE=server tsx tests/chantier_b_professional.test.ts",
    "test:schema-contract": "KURLA_STORE_MODE=server tsx tests/schema_query_contract.integration.test.ts",
    "test:chantier-7": "KURLA_STORE_MODE=memory KURLA_TEST_NO_SERVER=true tsx tests/chantier_7_routing.test.ts",
    "test:chantier-7-seo": "KURLA_STORE_MODE=memory KURLA_TEST_NO_SERVER=true tsx tests/chantier_7_seo.test.ts",
    "test:chantier-7-prerender": "KURLA_STORE_MODE=memory KURLA_TEST_NO_SERVER=true tsx tests/chantier_7_prerender.test.ts",
    "test:chantier-7-ingredients": "tsx tests/chantier_7_ingredients.realdb.test.ts",
    "test:chantier-7-i18n": "KURLA_STORE_MODE=memory KURLA_TEST_NO_SERVER=true tsx tests/chantier_7_i18n.test.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@supabase/supabase-js": "^2.112.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/three": "^0.185.3",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "gsap": "^3.15.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "stripe": "^22.4.0",
    "three": "^0.185.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
