# KURLA Beauty Environment Variables Example

# Server Configuration
PORT=3000
NODE_ENV=development
TRUST_PROXY=false

# Public browser origin used for Stripe return URLs (HTTPS in production)
VITE_APP_URL=http://localhost:3000

# Production API protection (use a shared edge limiter for multi-instance deployments)
CORS_ORIGIN=

# Gemini AI API Key (Server-Side)
GEMINI_API_KEY=

# Payment Processing (Stripe Integration)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_WEBHOOK_ENABLED=false
VITE_STRIPE_PUBLIC_KEY=

# Transactional emails: console is development-only; production supports resend, sendgrid or postmark
EMAIL_PROVIDER=console
EMAIL_PROVIDER_API_KEY=
EMAIL_FROM=no-reply@kurla-beauty.com

# Supabase Database Configuration (Primary Storage)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
VITE_SUPABASE_ANON_KEY=your-anon-key

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-secret-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Application & API URLs
