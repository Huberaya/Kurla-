{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "buildCommand": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --loader:.jpg=dataurl --loader:.png=dataurl --loader:.svg=dataurl --loader:.webp=dataurl --outfile=api/_server.cjs",
  "outputDirectory": "dist",
  "regions": [
    "cdg1"
  ],
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "includeFiles": "api/_server.cjs"
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
